# Generate a shared token with: openssl rand -hex 32
AUTOMATION_TOKEN=REPLACE_WITH_RANDOM_TOKEN
SPEAKER_HOST=192.0.2.10
# Unique logical node name; a process-specific suffix is added automatically.
VOICE_NODE=main
VOICE_ROLE=primary
# This node's reserved LAN address, reachable from the speaker.
VOICE_PUBLIC_URL=http://192.0.2.20:8787
VOICE_ASR_BACKEND=whisper-cpp-cuda-sm61
